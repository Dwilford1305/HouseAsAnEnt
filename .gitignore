# Ignore all real household data
data/raw/*
data/staging/*

# Allow specific mock files and placeholders
!data/raw/mock_*
!data/raw/sample_*
!data/raw/.gitkeep
!data/staging/.gitkeep

# Ignore Python environments and credentials
.env
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

*.pem
*.key

.DS_Store
Thumbs.db